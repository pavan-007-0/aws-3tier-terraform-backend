# Copy to .env for local development; never commit the real .env file.
DB_HOST=your-rds-endpoint
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=ecommerce_db
SECRET_KEY=generate-a-long-random-application-secret
JWT_SECRET_KEY=generate-a-long-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000
FLASK_ENV=development
FLASK_DEBUG=false
SECURITY_PASSWORD_SALT=generate-a-long-random-salt
RATELIMIT_STORAGE_URL=memory://
CORS_ORIGINS=http://localhost:4200
OLLAMA_MODEL=llama3.2
